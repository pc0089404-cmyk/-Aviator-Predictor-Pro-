# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PAYSTACK_SECRET_KEY: Your Paystack Live or Test Secret Key (e.g. sk_live_... or sk_test_...)
# Stored ONLY on server-side backend; never exposed to browser.
PAYSTACK_SECRET_KEY="sk_live_..."

# PAYSTACK_PUBLIC_KEY: Your Paystack Live or Test Public Key (e.g. pk_live_... or pk_test_...)
PAYSTACK_PUBLIC_KEY="pk_live_..."

# VITE_PAYSTACK_PUBLIC_KEY: Browser-accessible public key for client checkout popup
VITE_PAYSTACK_PUBLIC_KEY="pk_live_..."
